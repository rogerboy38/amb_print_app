{
 "name": "Label Management",
 "doctype": "DocType",
 "module": "Amb Print",
 "autoname": "format:LBL-MGMT-{#####}",
 "is_submittable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "name",
   "fieldtype": "Data",
   "label": "Name",
   "unique": 1,
   "insert_after": null
  },
  {
   "fieldname": "source_doctype",
   "fieldtype": "Select",
   "label": "Source DocType",
   "options": "Sales Order\nBatch AMB\nDelivery Note\nSales Invoice\nPurchase Order\nPurchase Receipt\nSample Request AMB",
   "insert_after": null
  },
  {
   "fieldname": "source_docname",
   "fieldtype": "Dynamic Link",
   "label": "Source Document",
   "options": "source_doctype",
   "insert_after": "source_doctype"
  },
  {
   "fieldname": "print_format",
   "fieldtype": "Select",
   "label": "Print Format",
   "options": "Label Logo 4\nLabel Blank 4\nLabel Small 8",
   "default": "Label Small 8",
   "insert_after": "source_docname"
  },
  {
   "fieldname": "start_position",
   "fieldtype": "Select",
   "label": "Start Position",
   "options": "A1\nB1\nA2\nB2\nA3\nB3\nA4\nB4",
   "default": "A1",
   "insert_after": "print_format"
  },
  {
   "fieldname": "label_qty",
   "fieldtype": "Int",
   "label": "Label Quantity",
   "default": "1",
   "insert_after": "start_position"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nReady\nPrinted\nError",
   "default": "Draft",
   "insert_after": "label_qty"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes",
   "insert_after": "status"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}