{
    "doctype": "Print Format",
    "name": "Label Hello World",
    "doc_type": "Sales Order",
    "module": "AMB Print",
    "print_format_type": "Jinja",
    "pdf": 1,
    "default_print_language": "es",
    "html": "<div class=\"label-container\" style=\"font-family: Arial, sans-serif; padding: 20px; border: 2px solid #333;\">\n    <h1 style=\"color: #e74c3c;\">HELLO WORLD</h1>\n    <p><strong>Sales Order:</strong> {{ doc.name }}</p>\n    <p><strong>Customer:</strong> {{ doc.customer }}</p>\n    <p><strong>Date:</strong> {{ doc.transaction_date }}</p>\n    <hr>\n    <h3>Items:</h3>\n    <table style=\"width: 100%; border-collapse: collapse;\">\n        <tr style=\"background: #f0f0f0;\">\n            <th style=\"border: 1px solid #ccc; padding: 5px;\">Item</th>\n            <th style=\"border: 1px solid #ccc; padding: 5px;\">Qty</th>\n        </tr>\n        {% for item in doc.items %}\n        <tr>\n            <td style=\"border: 1px solid #ccc; padding: 5px;\">{{ item.item_code }}</td>\n            <td style=\"border: 1px solid #ccc; padding: 5px;\">{{ item.qty }}</td>\n        </tr>\n        {% endfor %}\n    </table>\n</div>",
    "css": "",
    "layout": "Fixed",
    "absolute_html": 0,
    "align_labels_right": 0,
    "show_section_headings": 0,
    "line_breaks": 0,
    "raw_printing": 0,
    "asset_prefix": ""
}
