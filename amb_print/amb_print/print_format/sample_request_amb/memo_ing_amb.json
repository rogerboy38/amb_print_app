{
  "doctype": "Print Format",
  "name": "MEMO ING AMB",
  "doc_type": "Sample Request AMB",
  "module": "AMB Print",
  "standard": "No",
  "print_format_type": "Jinja",
  "html": "<style>\n.memo-header { text-align: center; border-bottom: 3px solid #1565c0; padding-bottom: 15px; margin-bottom: 25px; }\n.memo-title { font-size: 18pt; font-weight: bold; color: #1565c0; margin-bottom: 5px; }\n.memo-subtitle { font-size: 12pt; color: #666; }\n.memo-info-box { background: linear-gradient(to right, #f8f9ff, #ffffff); border: 2px solid #1565c0; border-radius: 8px; padding: 15px; margin-bottom: 20px; }\n.info-grid { display: table; width: 100%; }\n.info-row { display: table-row; }\n.info-label { display: table-cell; font-weight: bold; color: #1565c0; padding: 8px; width: 25%; text-transform: uppercase; font-size: 9pt; }\n.info-value { display: table-cell; padding: 8px; border-bottom: 1px solid #e0e0e0; }\n.section-header { background: linear-gradient(to right, #1565c0, #1976d2); color: white; padding: 10px 20px; font-weight: bold; font-size: 11pt; margin: 20px 0 10px 0; border-radius: 5px; }\n.checkbox-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 15px 0; }\n.checkbox-item { background: #f8f9ff; padding: 10px; border-radius: 5px; border-left: 4px solid #1565c0; font-size: 9pt; }\n.checkbox-item.checked { background: #e3f2fd; border-left-color: #2196f3; }\n.goods-table { width: 100%; border-collapse: collapse; margin: 15px 0; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }\n.goods-table th { background: #1565c0; color: white; padding: 12px; text-align: left; font-size: 9pt; text-transform: uppercase; }\n.goods-table td { padding: 10px; border-bottom: 1px solid #e0e0e0; font-size: 10pt; }\n.goods-table tr:nth-child(even) { background: #fafbff; }\n.total-row { background: #1565c0 !important; color: white; font-weight: bold; }\n.signature-area { margin-top: 60px; display: table; width: 100%; }\n.signature-box { display: table-cell; width: 50%; text-align: center; padding: 20px; }\n.signature-line { border-top: 2px solid #1565c0; width: 80%; margin: 0 auto 10px auto; padding-top: 40px; }\n.footer-note { margin-top: 30px; padding: 15px; background: #f5f5f5; border-radius: 5px; font-size: 9pt; color: #666; text-align: center; }\n</style>\n\n<div class=\"memo-header\">\n    <div class=\"memo-title\">INTERNAL MEMORANDUM</div>\n    <div class=\"memo-subtitle\">Agromayal Botánica, S.A. DE C.V.</div>\n</div>\n\n<div class=\"memo-info-box\">\n    <div class=\"info-grid\">\n        <div class=\"info-row\">\n            <div class=\"info-label\">Date:</div>\n            <div class=\"info-value\">{{ doc.request_date or '' }}</div>\n            <div class=\"info-label\">Request No.:</div>\n            <div class=\"info-value\"><strong>{{ doc.name }}</strong></div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">Customer:</div>\n            <div class=\"info-value\">{{ doc.customer_name or doc.customer or '' }}</div>\n            <div class=\"info-label\">Destination:</div>\n            <div class=\"info-value\">{{ doc.city or '' }}, {{ doc.state or '' }} {{ doc.postal_code or '' }}</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">Country:</div>\n            <div class=\"info-value\">{{ doc.country or '' }}</div>\n            <div class=\"info-label\">Contact:</div>\n            <div class=\"info-value\">{{ doc.contact_display or '' }}</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">Ship Date:</div>\n            <div class=\"info-value\">{{ doc.sample_delivery_date or 'TBD' }}</div>\n            <div class=\"info-label\">Carrier:</div>\n            <div class=\"info-value\">{{ doc.customs_carrier or 'TBD' }}</div>\n        </div>\n    </div>\n</div>\n\n<div class=\"section-header\">Requested Samples List</div>\n<table class=\"goods-table\">\n    <thead>\n        <tr>\n            <th>Quantity</th>\n            <th>Product</th>\n            <th>Description</th>\n            <th>Analysis No.</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.samples %}\n        <tr>\n            <td>{{ (item.samples_count * item.qty_per_sample) or 0 }} gr</td>\n            <td>{{ item.item_name or item.item or '' }}</td>\n            <td>{{ item.description or item.item_name or '' }}</td>\n            <td>{{ item.analysis_number or '' }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<div class=\"section-header\">Required Documentation</div>\n<div class=\"checkbox-grid\">\n    <div class=\"checkbox-item {% if doc.certificate_of_analysis %}checked{% endif %}\">☑ Certificate of Analysis (COA)</div>\n    <div class=\"checkbox-item {% if doc.fda_registration %}checked{% endif %}\">☑ FDA Registration</div>\n    <div class=\"checkbox-item {% if doc.phytosanitary_certificate %}checked{% endif %}\">☑ Phytosanitary Certificate</div>\n    <div class=\"checkbox-item {% if doc.commercial_invoice %}checked{% endif %}\">☑ Commercial Invoice</div>\n    <div class=\"checkbox-item {% if doc.packing_list %}checked{% endif %}\">☑ Packing List</div>\n    <div class=\"checkbox-item {% if doc.bill_of_lading %}checked{% endif %}\">☑ Bill of Lading</div>\n    <div class=\"checkbox-item {% if doc.customs_declaration %}checked{% endif %}\">☑ Customs Declaration</div>\n    <div class=\"checkbox-item {% if doc.import_permit %}checked{% endif %}\">☑ Import Permit</div>\n    <div class=\"checkbox-item {% if doc.agricultural_license %}checked{% endif %}\">☑ Agricultural License</div>\n    <div class=\"checkbox-item {% if doc.health_certificate %}checked{% endif %}\">☑ Health Certificate</div>\n    <div class=\"checkbox-item {% if doc.microbiological_analysis %}checked{% endif %}\">☑ Microbiological Analysis</div>\n    <div class=\"checkbox-item {% if doc.certificate_of_origin %}checked{% endif %}\">☑ Certificate of Origin</div>\n</div>\n\n<div class=\"section-header\">Shipment Nature</div>\n<div class=\"checkbox-grid\">\n    <div class=\"checkbox-item {% if doc.shipment_nature == 'Venta' %}checked{% endif %}\">☑ Sale</div>\n    <div class=\"checkbox-item {% if doc.shipment_nature == 'Muestra sin valor comercial' %}checked{% endif %}\">☑ Sample without commercial value</div>\n    <div class=\"checkbox-item {% if doc.shipment_nature == 'Donación' %}checked{% endif %}\">☑ Donation</div>\n    <div class=\"checkbox-item {% if doc.internal_export_type == 'Exportación temporal' %}checked{% endif %}\">☑ Temporary Export</div>\n    <div class=\"checkbox-item {% if doc.internal_export_type == 'Exportación definitiva' %}checked{% endif %}\">☑ Definitive Export</div>\n    <div class=\"checkbox-item {% if doc.special_export_type %}checked{% endif %}\">☑ {{ doc.special_export_type or 'Other' }}</div>\n</div>\n\n<div class=\"section-header\">Shipment Details</div>\n<div class=\"memo-info-box\">\n    <div class=\"info-grid\">\n        <div class=\"info-row\">\n            <div class=\"info-label\">Waybill No.:</div>\n            <div class=\"info-value\">{{ doc.waybill_number or '' }}</div>\n            <div class=\"info-label\">Shipment Type:</div>\n            <div class=\"info-value\">{{ doc.shipment_type or '' }}</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">No. Packages:</div>\n            <div class=\"info-value\">{{ doc.number_of_packages or '1' }}</div>\n            <div class=\"info-label\">Gross Weight:</div>\n            <div class=\"info-value\">{{ doc.gross_weight_kg or '0.5' }} kg</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">Customs Entry:</div>\n            <div class=\"info-value\">{{ doc.pedimento_required or 'Yes' }}</div>\n            <div class=\"info-label\">Entry Type:</div>\n            <div class=\"info-value\">{{ doc.pedimento_type or 'Temporary' }}</div>\n        </div>\n    </div>\n</div>\n\n<div class=\"section-header\">Workflow Tracking</div>\n<div class=\"checkbox-grid\">\n    <div class=\"checkbox-item {% if doc.confirm_po %}checked{% endif %}\">☑ PO Confirmed</div>\n    <div class=\"checkbox-item {% if doc.confirm_proforma %}checked{% endif %}\">☑ Proforma Confirmed</div>\n    <div class=\"checkbox-item {% if doc.confirm_shipment %}checked{% endif %}\">☑ Shipment Confirmed</div>\n    <div class=\"checkbox-item {% if doc.confirm_delivery %}checked{% endif %}\">☑ Delivery Confirmed</div>\n    <div class=\"checkbox-item {% if doc.tracking_updated %}checked{% endif %}\">☑ Tracking Updated</div>\n</div>\n\n<div class=\"signature-area\">\n    <div class=\"signature-box\">\n        <div class=\"signature-line\"></div>\n        <strong>Export Manager</strong>\n    </div>\n    <div class=\"signature-box\">\n        <div class=\"signature-line\"></div>\n        <strong>Logistics</strong>\n    </div>\n</div>\n\n<div class=\"footer-note\">\n    <strong>Note:</strong> This memorandum is for internal use only of Agromayal Botánica, S.A. DE C.V.<br>\n    Any shipment must have Management approval before proceeding.\n</div>",
  "css": "",
  "disabled": 0
}
