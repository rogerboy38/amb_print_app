{
  "doctype": "Print Format",
  "name": "MEMO ESP AMB",
  "doc_type": "Sample Request AMB",
  "module": "AMB Print",
  "standard": "No",
  "custom_format": 1,
  "print_format_type": "Jinja",
  "raw_printing": 0,
  "html": "<!-- MEMO ESP AMB - Memo en Español Print Format -->\n\n<style>\n@page {\n    size: letter;\n    margin: 25mm 20mm 20mm 25mm;\n}\n\n.print-format {\n    font-family: Arial, sans-serif;\n    font-size: 11pt;\n    line-height: 1.6;\n}\n\n.memo-header {\n    text-align: right;\n    margin-bottom: 30px;\n}\n\n.memo-location {\n    font-weight: normal;\n}\n\n\n.memo-date {\n    margin-top: 5px;\n}\n\n.memo-to-section {\n    margin-bottom: 20px;\n}\n\n.memo-body-section {\n    margin-bottom: 20px;\n    text-align: justify;\n}\n\n.memo-product-box {\n    margin: 20px 0;\n    padding: 15px 20px;\n    background-color: #f8f9fa;\n    border-left: 4px solid #27ae60;\n}\n\n.memo-product-label {\n    font-weight: bold;\n    color: #2c3e50;\n}\n\n\n.memo-product-value {\n    margin-top: 5px;\n}\n\n\n.memo-value-section {\n    margin: 20px 0;\n    font-weight: bold;\n}\n\n.memo-footer-section {\n    margin-top: 30px;\n}\n\n\n.memo-attention {\n    margin-bottom: 30px;\n}\n\n.memo-signature {\n    margin-top: 60px;\n}\n\n.signature-name {\n    font-weight: bold;\n}\n\n.signature-company {\n    font-weight: bold;\n    color: #27ae60;\n}\n\n.signature-address {\n    line-height: 1.4;\n}\n\n.footer-note {\n    margin-top: 50px;\n    font-size: 9pt;\n    color: #666;\n    font-style: italic;\n}\n</style>\n\n\n<div class=\"print-format\">\n    <!-- Header: Location and Date -->\n    <div class=\"memo-header\">\n        <div class=\"memo-location\">TORREON, COAHUILA, MEXICO</div>\n        <div class=\"memo-date\">A {{ doc.request_date or '' }}</div>\n    </div>\n\n    <!-- To Whom It May Concern -->\n    <div class=\"memo-to-section\">\n        <strong>A QUIEN CORRESPONDA:</strong>\n    </div>\n\n    <!-- Body -->\n    <div class=\"memo-body-section\">\n        POR MEDIO DE LA PRESENTE HACEMOS DE SU CONOCIMIENTO QUE NUESTRO EMBARQUE CONSISTE EN:\n    </div>\n\n    <!-- Product Box -->\n    <div class=\"memo-product-box\">\n        <div class=\"memo-product-label\">PRODUCTO:</div>\n        <div class=\"memo-product-value\">\n            MUESTRAS DE {% if doc.item_name %}{{ doc.item_name | upper }}{% else %}PRODUCTO{% endif %} ( POLVO )\n            {% for item in doc.samples %}\n            <br>EN {{ item.samples_count or '1' }} BOLSA(S) ESTERIL(ES) CON {{ item.qty_per_sample or '250' }} GR CADA UNA.\n            {% endfor %}\n            <br>CON UN TOTAL DE {{ doc.total_net_weight or '750' }} GR\n        </div>\n    </div>\n\n\n    <!-- Commercial Value -->\n    <div class=\"memo-value-section\">\n        VALOR PARA EFECTOS ADUANALES SIN VALOR COMERCIAL: $ {{ doc.commercial_value_usd or '1.00' }} USD\n    </div>\n\n    <!-- Purpose Statement -->\n    <div class=\"memo-body-section\">\n        ES UN PRODUCTO 100% NATURAL Y SERA EVALUADO POR NUESTRO CLIENTE PARA PRUEBAS DE LABORATORIO.\n    </div>\n\n    <div class=\"memo-body-section\">\n        ANEXAMOS COPIA DE LAS HOJAS TECNICAS.\n    </div>\n\n    <div class=\"memo-body-section\">\n        ATENTAMENTE,\n    </div>\n\n    <!-- Signature -->\n    <div class=\"memo-signature\">\n        <div class=\"signature-name\">ALONDRA ESTEFANIA LOERA SALAZAR</div>\n        <br><br>\n        <div class=\"signature-company\">Agromaya Botánica S.A. de C.V.</div>\n        <div class=\"signature-address\">\n            Calle Guanacevi 245<br>\n            Parque Industrial Gomez Palacio<br>\n            Durango, Mexico\n        </div>\n    </div>\n</div>",
  "css": "",
  "disabled": 0
}
