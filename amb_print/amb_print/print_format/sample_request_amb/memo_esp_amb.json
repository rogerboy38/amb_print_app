{
  "doctype": "Print Format",
  "name": "MEMO ESP AMB",
  "doc_type": "Sample Request AMB",
  "module": "AMB Print",
  "standard": "No",
  "print_format_type": "Jinja",
  "html": "<style>\n.memo-header { text-align: center; border-bottom: 3px solid #1a5f2a; padding-bottom: 15px; margin-bottom: 25px; }\n.memo-title { font-size: 18pt; font-weight: bold; color: #1a5f2a; margin-bottom: 5px; }\n.memo-subtitle { font-size: 12pt; color: #666; }\n.memo-info-box { background: linear-gradient(to right, #f8fff8, #ffffff); border: 2px solid #1a5f2a; border-radius: 8px; padding: 15px; margin-bottom: 20px; }\n.info-grid { display: table; width: 100%; }\n.info-row { display: table-row; }\n.info-label { display: table-cell; font-weight: bold; color: #1a5f2a; padding: 8px; width: 25%; text-transform: uppercase; font-size: 9pt; }\n.info-value { display: table-cell; padding: 8px; border-bottom: 1px solid #e0e0e0; }\n.section-header { background: linear-gradient(to right, #1a5f2a, #2d7a42); color: white; padding: 10px 20px; font-weight: bold; font-size: 11pt; margin: 20px 0 10px 0; border-radius: 5px; }\n.checkbox-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 15px 0; }\n.checkbox-item { background: #f8fff8; padding: 10px; border-radius: 5px; border-left: 4px solid #1a5f2a; font-size: 9pt; }\n.checkbox-item.checked { background: #e8f5e9; border-left-color: #4caf50; }\n.goods-table { width: 100%; border-collapse: collapse; margin: 15px 0; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }\n.goods-table th { background: #1a5f2a; color: white; padding: 12px; text-align: left; font-size: 9pt; text-transform: uppercase; }\n.goods-table td { padding: 10px; border-bottom: 1px solid #e0e0e0; font-size: 10pt; }\n.goods-table tr:nth-child(even) { background: #f9fff9; }\n.total-row { background: #1a5f2a !important; color: white; font-weight: bold; }\n.signature-area { margin-top: 60px; display: table; width: 100%; }\n.signature-box { display: table-cell; width: 50%; text-align: center; padding: 20px; }\n.signature-line { border-top: 2px solid #1a5f2a; width: 80%; margin: 0 auto 10px auto; padding-top: 40px; }\n.footer-note { margin-top: 30px; padding: 15px; background: #f5f5f5; border-radius: 5px; font-size: 9pt; color: #666; text-align: center; }\n</style>\n\n<div class=\"memo-header\">\n    <div class=\"memo-title\">MEMORÁNDUM INTERNO</div>\n    <div class=\"memo-subtitle\">Agromayal Botánica, S.A. DE C.V.</div>\n</div>\n\n<div class=\"memo-info-box\">\n    <div class=\"info-grid\">\n        <div class=\"info-row\">\n            <div class=\"info-label\">Fecha:</div>\n            <div class=\"info-value\">{{ doc.request_date or '' }}</div>\n            <div class=\"info-label\">Solicitud No.:</div>\n            <div class=\"info-value\"><strong>{{ doc.name }}</strong></div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">Cliente:</div>\n            <div class=\"info-value\">{{ doc.customer_name or doc.customer or '' }}</div>\n            <div class=\"info-label\">Destino:</div>\n            <div class=\"info-value\">{{ doc.city or '' }}, {{ doc.state or '' }} {{ doc.postal_code or '' }}</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">País:</div>\n            <div class=\"info-value\">{{ doc.country or '' }}</div>\n            <div class=\"info-label\">Contacto:</div>\n            <div class=\"info-value\">{{ doc.contact_display or '' }}</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">Fecha Envío:</div>\n            <div class=\"info-value\">{{ doc.sample_delivery_date or 'Por confirmar' }}</div>\n            <div class=\"info-label\">Transportista:</div>\n            <div class=\"info-value\">{{ doc.customs_carrier or 'Por definir' }}</div>\n        </div>\n    </div>\n</div>\n\n<div class=\"section-header\">Lista de Muestras Solicitadas</div>\n<table class=\"goods-table\">\n    <thead>\n        <tr>\n            <th>Cantidad</th>\n            <th>Producto</th>\n            <th>Descripción</th>\n            <th>No. Análisis</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.samples %}\n        <tr>\n            <td>{{ (item.samples_count * item.qty_per_sample) or 0 }} gr</td>\n            <td>{{ item.item_name or item.item or '' }}</td>\n            <td>{{ item.description or item.item_name or '' }}</td>\n            <td>{{ item.analysis_number or '' }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<div class=\"section-header\">Documentación Requerida</div>\n<div class=\"checkbox-grid\">\n    <div class=\"checkbox-item {% if doc.certificate_of_analysis %}checked{% endif %}\">☑ Certificado de Análisis (COA)</div>\n    <div class=\"checkbox-item {% if doc.fda_registration %}checked{% endif %}\">☑ Registro FDA</div>\n    <div class=\"checkbox-item {% if doc.phytosanitary_certificate %}checked{% endif %}\">☑ Certificado Fitosanitario</div>\n    <div class=\"checkbox-item {% if doc.commercial_invoice %}checked{% endif %}\">☑ Factura Comercial</div>\n    <div class=\"checkbox-item {% if doc.packing_list %}checked{% endif %}\">☑ Lista de Empaque</div>\n    <div class=\"checkbox-item {% if doc.bill_of_lading %}checked{% endif %}\">☑ Conocimiento de Embarque</div>\n    <div class=\"checkbox-item {% if doc.customs_declaration %}checked{% endif %}\">☑ Declaración Aduanera</div>\n    <div class=\"checkbox-item {% if doc.import_permit %}checked{% endif %}\">☑ Permiso de Importación</div>\n    <div class=\"checkbox-item {% if doc.agricultural_license %}checked{% endif %}\">☑ Licencia Agrícola</div>\n    <div class=\"checkbox-item {% if doc.health_certificate %}checked{% endif %}\">☑ Certificado Sanitario</div>\n    <div class=\"checkbox-item {% if doc.microbiological_analysis %}checked{% endif %}\">☑ Análisis Microbiológico</div>\n    <div class=\"checkbox-item {% if doc.certificate_of_origin %}checked{% endif %}\">☑ Certificado de Origen</div>\n</div>\n\n<div class=\"section-header\">Naturaleza del Envío</div>\n<div class=\"checkbox-grid\">\n    <div class=\"checkbox-item {% if doc.shipment_nature == 'Venta' %}checked{% endif %}\">☑ Venta</div>\n    <div class=\"checkbox-item {% if doc.shipment_nature == 'Muestra sin valor comercial' %}checked{% endif %}\">☑ Muestra sin valor comercial</div>\n    <div class=\"checkbox-item {% if doc.shipment_nature == 'Donación' %}checked{% endif %}\">☑ Donación</div>\n    <div class=\"checkbox-item {% if doc.internal_export_type == 'Exportación temporal' %}checked{% endif %}\">☑ Exportación temporal</div>\n    <div class=\"checkbox-item {% if doc.internal_export_type == 'Exportación definitiva' %}checked{% endif %}\">☑ Exportación definitiva</div>\n    <div class=\"checkbox-item {% if doc.special_export_type %}checked{% endif %}\">☑ {{ doc.special_export_type or 'Otro' }}</div>\n</div>\n\n<div class=\"section-header\">Detalles del Envío</div>\n<div class=\"memo-info-box\">\n    <div class=\"info-grid\">\n        <div class=\"info-row\">\n            <div class=\"info-label\">No. Guía:</div>\n            <div class=\"info-value\">{{ doc.waybill_number or '' }}</div>\n            <div class=\"info-label\">Tipo de Envío:</div>\n            <div class=\"info-value\">{{ doc.shipment_type or '' }}</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">No. Paquetes:</div>\n            <div class=\"info-value\">{{ doc.number_of_packages or '1' }}</div>\n            <div class=\"info-label\">Peso Bruto:</div>\n            <div class=\"info-value\">{{ doc.gross_weight_kg or '0.5' }} kg</div>\n        </div>\n        <div class=\"info-row\">\n            <div class=\"info-label\">Pedimento:</div>\n            <div class=\"info-value\">{{ doc.pedimento_required or 'Sí' }}</div>\n            <div class=\"info-label\">Tipo Pedimento:</div>\n            <div class=\"info-value\">{{ doc.pedimento_type or 'Temporal' }}</div>\n        </div>\n    </div>\n</div>\n\n<div class=\"section-header\">Seguimiento</div>\n<div class=\"checkbox-grid\">\n    <div class=\"checkbox-item {% if doc.confirm_po %}checked{% endif %}\">☑ PO Confirmado</div>\n    <div class=\"checkbox-item {% if doc.confirm_proforma %}checked{% endif %}\">☑ Proforma Confirmada</div>\n    <div class=\"checkbox-item {% if doc.confirm_shipment %}checked{% endif %}\">☑ Envío Confirmado</div>\n    <div class=\"checkbox-item {% if doc.confirm_delivery %}checked{% endif %}\">☑ Entrega Confirmada</div>\n    <div class=\"checkbox-item {% if doc.tracking_updated %}checked{% endif %}\">☑ Tracking Actualizado</div>\n</div>\n\n<div class=\"signature-area\">\n    <div class=\"signature-box\">\n        <div class=\"signature-line\"></div>\n        <strong>Gerencia de Exportaciones</strong>\n    </div>\n    <div class=\"signature-box\">\n        <div class=\"signature-line\"></div>\n        <strong>Logística</strong>\n    </div>\n</div>\n\n<div class=\"footer-note\">\n    <strong>Nota:</strong> Este memorándum es solo para uso interno de Agromayal Botánica, S.A. DE C.V.<br>\n    Cualquier envío debe contar con la aprobación de Gerencia antes de proceder.\n</div>",
  "css": "",
  "disabled": 0
}
