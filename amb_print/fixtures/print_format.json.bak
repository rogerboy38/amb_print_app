  "html": "{% set page_width = \"215.9mm\" %}\n{% set page_height = \"279.4mm\" %}\n{% set label_width = \"82mm\" %}\n{% set label_height = \"58mm\" %}\n{% set cols = 2 %}\n{% set rows = 4 %}\n\n{% set positions = [\"A1\", \"B1\", \"A2\", \"B2\", \"A3\", \"B3\", \"A4\", \"B4\"] %}\n{% set start_position = frappe.form_dict.get(\"start_position\") or \"A1\" %}\n{% set label_qty = (frappe.form_dict.get(\"label_qty\") or 8) | int %}\n\n{% if start_position not in positions %}\n    {% set start_position = \"A1\" %}\n{% endif %}\n\n{% if label_qty < 1 %}\n    {% set label_qty = 1 %}\n{% endif %}\n{% if label_qty > 8 %}\n    {% set label_qty = 8 %}\n{% endif %}\n\n{% set start_index = positions.index(start_position) %}\n\n{# Get linked Work Order data if available #}\n{% set work_order_data = None %}\n{% if not is_sample_request and doc.work_order_ref %}\n    {% set work_order_data = frappe.get_doc(\"Work Order\", doc.work_order_ref) %}\n{% endif %}\n\n{# Get linked Sales Order data if available #}\n{% set sales_order_data = None %}\n{% if not is_sample_request and doc.sales_order_related %}\n    {% set sales_order_data = frappe.get_doc(\"Sales Order\", doc.sales_order_related) %}\n{% endif %}\n\n{# Get Sample Request AMB data if this is a Sample Request AMB doc #}\n{% set is_sample_request = (doc.doctype == \"Sample Request AMB\") %}\n{% if is_sample_request and doc.item %}\n    {% set sr_item_doc = frappe.get_doc(\"Item\", doc.item) %}\n{% else %}\n    {% set sr_item_doc = None %}\n{% endif %}\n\n<style>\n    @page {\n        size: 215.9mm 279.4mm;\n        margin: 0;\n    }\n    html, body {\n        margin: 0;\n        padding: 0;\n        width: 215.9mm;\n        height: 279.4mm;\n        font-family: Arial, Helvetica, sans-serif;\n        background: #fff;\n    }\n    body { overflow: hidden; }\n    .sheet {\n        position: relative;\n        width: 215.9mm;\n        height: 279.4mm;\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n        background: #fff;\n    }\n    .label-cell {\n        position: absolute;\n        width: 82mm;\n        height: 58mm;\n        box-sizing: border-box;\n        overflow: hidden;\n    }\n    .label-content {\n        position: absolute;\n        top: 29mm;\n        left: 15mm;\n        width: 58mm;\n        height: 24mm;\n        box-sizing: border-box;\n        overflow: hidden;\n    }\n    .brand {\n        font-size: 9pt;\n        font-weight: 700;\n        color: #111;\n        line-height: 1.05;\n        margin: 0 0 2.2mm 0;\n        white-space: normal;\n        word-break: break-word;\n        overflow-wrap: anywhere;\n    }\n    .meta-row { width: 100%; overflow: hidden; margin: 0 0 2mm 0; }\n    .meta-block { float: left; width: 27mm; margin-right: 4mm; }\n    .meta-block.last { margin-right: 0; }\n    .meta-label { font-size: 5pt; font-weight: 700; text-transform: uppercase; color: #444; line-height: 1.05; margin: 0 0 0.4mm 0; }\n    .meta-value { font-size: 6.8pt; color: #111; line-height: 1.08; margin: 0; white-space: normal; word-break: break-word; overflow-wrap: anywhere; }\n    .item-name { font-size: 7.6pt; line-height: 1.05; font-weight: 700; color: #1d6b36; margin: 0 0 2mm 0; white-space: normal; word-break: break-word; overflow-wrap: anywhere; }\n    .small-row { width: 100%; overflow: hidden; margin: 0; }\n    .small-block { float: left; width: 27mm; margin-right: 4mm; }\n    .small-block.last { margin-right: 0; }\n    .small-label { font-size: 5pt; font-weight: 700; text-transform: uppercase; color: #444; line-height: 1.05; margin: 0 0 0.4mm 0; }\n    .small-value { font-size: 6.8pt; color: #111; line-height: 1.08; margin: 0; white-space: normal; word-break: break-word; overflow-wrap: anywhere; }\n    .position-marker { display: none; position: absolute; top: 1mm; right: 1mm; font-size: 5pt; color: #888; font-weight: 700; }\n</style>\n\n<div class=\"sheet\">\n    {% for row in range(rows) %}\n        {% for col in range(cols) %}\n            {% set slot = row * cols + col %}\n            {% set position = positions[slot] %}\n            {% set relative_index = slot - start_index %}\n            {% set should_print = slot >= start_index and relative_index < label_qty %}\n\n            {% if col == 0 %}\n                {% set left_pos = \"25mm\" %}\n            {% else %}\n                {% set left_pos = \"128mm\" %}\n            {% endif %}\n\n            {% if row == 0 %}\n                {% set top_pos = \"12mm\" %}\n            {% elif row == 1 %}\n                {% set top_pos = \"78mm\" %}\n            {% elif row == 2 %}\n                {% set top_pos = \"144mm\" %}\n            {% else %}\n                {% set top_pos = \"210mm\" %}\n            {% endif %}\n\n            <div class=\"label-cell\" style=\"left: {{ left_pos }}; top: {{ top_pos }};\">\n                <div class=\"position-marker\">{{ position }}</div>\n                {% if should_print %}\n                    <div class=\"label-content\">\n                        {# Customer name from Sales Order or direct #}\n                        <p class=\"brand\">{{ doc.customer_name if is_sample_request else (sales_order_data.customer_name if sales_order_data else doc.company or \"\") }}</p>\n\n                        <div class=\"meta-row\">\n                            <div class=\"meta-block\">\n                                <div class=\"meta-label\">Batch</div>\n                                <div class=\"meta-value\">{{ doc.batch_reference if is_sample_request else (doc.name or \"\") }}</div>\n                            </div>\n                            <div class=\"meta-block last\">\n                                <div class=\"meta-label\">Date</div>\n                                <div class=\"meta-value\">{{ doc.request_date if is_sample_request else (doc.production_start_date or \"\") }}</div>\n                            </div>\n                        </div>\n\n                        <p class=\"item-name\">{{ (sr_item_doc.item_name if sr_item_doc else doc.item) if is_sample_request else (doc.item_name or doc.item_code or \"\") }}</p>\n\n                        <div class=\"small-row\">\n                            <div class=\"small-block\">\n                                <div class=\"small-label\">Qty</div>\n                                <div class=\"small-value\">{{ doc.batch_quantity or 0 }} {{ doc.uom or \"\" }}</div>\n                            </div>\n                            <div class=\"small-block last\">\n                                <div class=\"small-label\">Brix</div>\n                                <div class=\"meta-value\">{{ (doc.custom_product_key_tds or \"N/A\") if is_sample_request else (doc.brix_level or \"N/A\") }}</div>\n                            </div>\n                        </div>\n                    </div>\n                {% endif %}\n            </div>\n        {% endfor %}\n    {% endfor %}\n</div>\n",
  "line_breaks": 0,
