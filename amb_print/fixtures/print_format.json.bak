  "html": "{% set page_width = \"215.9mm\" %}\n{% set page_height = \"279.4mm\" %}\n{% set cell_width = \"107.95mm\" %}\n{% set cell_height = \"139.7mm\" %}\n{% set lsp = doc.label_start_position or \"A1\" %}\n{% set lqty = (doc.label_qty or 4) | int %}\n{% set pos_map = {\"A1\": 0, \"B1\": 1, \"A2\": 2, \"B2\": 3} %}\n{% set sidx = pos_map[lsp] if lsp in pos_map else 0 %}\n\n\n<style>\n.print-format-gutter { padding: 0 !important; margin: 0 !important; max-width: none !important; width: 100% !important; } .print-format { padding: 0 !important; margin: 0 !important; max-width: none !important; width: 100% !important; }\n\n    @page {\n        size: 215.9mm 279.4mm;\n        margin: 0;\n    }\n    body {\n        margin: 0;\n        padding: 0;\n        font-family: Arial, Helvetica, sans-serif;\n    }\n    .label-sheet {\n            overflow: hidden;\n        width: 215.9mm;\n        height: 279.4mm;\n        \n        \n        \n        padding: 0;\n        margin: 0;\n        box-sizing: border-box;\n    }\n    .label-cell {\n            float: left;\n        width: 107.95mm;\n        height: 139.7mm;\n        box-sizing: border-box;\n        position: relative;\n        overflow: hidden;\n    }\n    .label-content {\n        /* Clear center zone - avoid top 25mm, right 25mm, bottom 22mm */\n        position: absolute;\n        top: 25mm;\n        left: 8mm;\n        right: 28mm;\n        bottom: 22mm;\n        font-size: 7pt;\n        line-height: 1.3;\n        \n        flex-direction: column;\n        gap: 2mm;\n    }\n    .label-content .field-label {\n        font-weight: bold;\n        font-size: 6pt;\n        color: #444;\n        text-transform: uppercase;\n        margin: 0;\n        line-height: 1.2;\n    }\n    .label-content .field-value {\n        font-size: 8pt;\n        color: #000;\n        margin: 0;\n        line-height: 1.2;\n    }\n    .label-content .item-name {\n        font-size: 9pt;\n        font-weight: bold;\n        color: #1a5c2a;\n        margin: 0;\n        line-height: 1.2;\n    }\n    .label-content .customer-name {\n        font-size: 9pt;\n        font-weight: bold;\n        margin: 0;\n        line-height: 1.2;\n    }\n    .label-content .section {\n        margin-bottom: 1mm;\n    }\n    .label-content .row {\n        \n        justify-content: space-between;\n        margin-bottom: 1mm;\n    }\n    .label-content .row .field {\n        flex: 1;\n    }\n    .label-content .row .field:not(:last-child) {\n        margin-right: 3mm;\n    }\n</style>\n\n<div class=\"label-sheet\">\n    {# Repeat the same label 4 times (2x2 grid) #}\n    {% for i in range(4) %}\n{% set sprnt = (i >= sidx and (i - sidx) < lqty) %}\n\n    <div class=\"label-cell\">\n        <div class=\"label-content\" style=\"{% if not sprnt %}visibility: hidden;{% endif %}\">\n            <div class=\"section\">\n                <div class=\"customer-name\">{{ doc.customer_name or doc.customer }}</div>\n            </div>\n            \n            <div class=\"section\">\n                <div class=\"row\">\n                    <div class=\"field\">\n                        <div class=\"field-label\">Sales Order</div>\n                        <div class=\"field-value\">{{ doc.name }}</div>\n                    </div>\n                    <div class=\"field\">\n                        <div class=\"field-label\">Date</div>\n                        <div class=\"field-value\">{{ doc.transaction_date | default(\"\") }}</div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"section\">\n                <div class=\"row\">\n                    <div class=\"field\">\n                        <div class=\"field-label\">Delivery</div>\n                        <div class=\"field-value\">{{ doc.delivery_date | default(\"\") }}</div>\n                    </div>\n                    <div class=\"field\">\n                        <div class=\"field-label\">PO No.</div>\n                        <div class=\"field-value\">{{ doc.po_no or \"N/A\" }}</div>\n                    </div>\n                </div>\n            </div>\n            \n            {% if doc.items %}\n            {% set item = doc.items[0] %}\n            <div class=\"section\">\n                <div class=\"item-name\">{{ item.item_name or item.item_code }}</div>\n                <div class=\"row\">\n                    <div class=\"field\">\n                        <div class=\"field-label\">Code</div>\n                        <div class=\"field-value\">{{ item.item_code }}</div>\n                    </div>\n                    <div class=\"field\">\n                        <div class=\"field-label\">Qty</div>\n                        <div class=\"field-value\">{{ item.qty }} {{ item.uom }}</div>\n                    </div>\n                </div>\n                {% if item.description %}\n                <div class=\"field-label\">Description</div>\n                <div class=\"field-value\" style=\"font-size: 7pt;\">{{ item.description | truncate(60) }}</div>\n                {% endif %}\n            </div>\n            {% endif %}\n        </div>\n    </div>\n    {% endfor %}\n</div>",
