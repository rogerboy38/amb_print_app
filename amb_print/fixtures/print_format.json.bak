  "html": "<!-- COTIZACION_CANADA - Canada Style Quotation Print Format -->\n\n<style>\n@page {\n    size: letter;\n    margin: 12mm 10mm 15mm 10mm;\n}\n\n.print-format {\n    font-family: Arial, sans-serif;\n    font-size: 9pt;\n    color: #333;\n}\n\n.header-row {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 15px;\n    border-bottom: 2px solid #2E7D32;\n    padding-bottom: 10px;\n}\n\n.company-info {\n    text-align: right;\n}\n\n.company-name {\n    font-size: 16pt;\n    font-weight: bold;\n    color: #2E7D32;\n}\n\n.doc-title {\n    font-size: 20pt;\n    font-weight: bold;\n    text-align: center;\n    color: #2E7D32;\n    margin: 15px 0;\n    text-transform: uppercase;\n}\n\n.address-section {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 20px;\n}\n\n.address-box {\n    width: 48%;\n    padding: 10px;\n    background-color: #f5f5f5;\n    border-radius: 5px;\n    border-left: 3px solid #2E7D32;\n}\n\n.address-title {\n    font-weight: bold;\n    color: #2E7D32;\n    margin-bottom: 8px;\n    font-size: 10pt;\n}\n\n.address-content {\n    font-size: 9pt;\n    line-height: 1.4;\n}\n\n.meta-section {\n    display: flex;\n    justify-content: space-between;\n    background-color: #E8F5E9;\n    padding: 10px;\n    border-radius: 5px;\n    margin-bottom: 15px;\n}\n\n.meta-item {\n    text-align: center;\n}\n\n.meta-label {\n    font-size: 8pt;\n    color: #666;\n    text-transform: uppercase;\n}\n\n.meta-value {\n    font-size: 11pt;\n    font-weight: bold;\n    color: #2E7D32;\n}\n\n.items-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 10px;\n}\n\n.items-table th {\n    background-color: #2E7D32;\n    color: white;\n    padding: 10px 8px;\n    text-align: left;\n    font-size: 9pt;\n    font-weight: bold;\n}\n\n.items-table td {\n    padding: 8px;\n    border-bottom: 1px solid #ddd;\n    font-size: 9pt;\n    vertical-align: top;\n}\n\n.items-table tr:nth-child(even) {\n    background-color: #f9f9f9;\n}\n\n.item-name {\n    font-weight: bold;\n    color: #333;\n}\n\n.totals-section {\n    margin-top: 20px;\n    display: flex;\n    justify-content: flex-end;\n}\n\n.totals-table {\n    width: 280px;\n}\n\n.totals-table td {\n    padding: 6px 10px;\n    border-bottom: 1px solid #eee;\n}\n\n.totals-table .total-row {\n    background-color: #2E7D32;\n    color: white;\n    font-weight: bold;\n    font-size: 11pt;\n}\n\n.footer-section {\n    margin-top: 25px;\n    padding-top: 15px;\n    border-top: 1px solid #ddd;\n    font-size: 8pt;\n    color: #666;\n}\n</style>\n\n<div class=\"print-format\">\n    <!-- Header -->\n    <div class=\"header-row\">\n        <div class=\"logo-area\">\n            <!-- Logo via Letter Head -->\n        </div>\n        <div class=\"company-info\">\n            <div class=\"company-name\">{{ doc.company }}</div>\n        </div>\n    </div>\n\n    <div class=\"doc-title\">QUOTATION</div>\n\n    <!-- Address Section -->\n    <div class=\"address-section\">\n        <div class=\"address-box\">\n            <div class=\"address-title\">BILL TO / CUSTOMER</div>\n            <div class=\"address-content\">\n                <strong>{{ doc.customer_name }}</strong><br>\n                {{ doc.address_display or '' }}\n                {% if doc.contact_display %}\n                <br>Contact: {{ doc.contact_display }}\n                {% endif %}\n                {% if doc.contact_email %}\n                <br>Email: {{ doc.contact_email }}\n                {% endif %}\n                {% if doc.contact_mobile or doc.contact_phone %}\n                <br>Phone: {{ doc.contact_mobile or doc.contact_phone }}\n                {% endif %}\n            </div>\n        </div>\n        <div class=\"address-box\">\n            <div class=\"address-title\">SHIP TO</div>\n            <div class=\"address-content\">\n                {% if doc.shipping_address %}\n                {{ doc.shipping_address_name }}<br>\n                {{ doc.shipping_address }}\n                {% else %}\n                Same as billing address\n                {% endif %}\n            </div>\n        </div>\n    </div>\n\n    <!-- Document Meta -->\n    <div class=\"meta-section\">\n        <div class=\"meta-item\">\n            <div class=\"meta-label\">Quotation No.</div>\n            <div class=\"meta-value\">{{ doc.name }}</div>\n        </div>\n        <div class=\"meta-item\">\n            <div class=\"meta-label\">Date</div>\n            <div class=\"meta-value\">{{ doc.transaction_date }}</div>\n        </div>\n        <div class=\"meta-item\">\n            <div class=\"meta-label\">Valid Until</div>\n            <div class=\"meta-value\">{{ doc.valid_till or 'N/A' }}</div>\n        </div>\n        <div class=\"meta-item\">\n            <div class=\"meta-label\">Currency</div>\n            <div class=\"meta-value\">{{ doc.currency }}</div>\n        </div>\n    </div>\n\n    <!-- Items Table -->\n    <table class=\"items-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 8%\">Code</th>\n                <th style=\"width: 42%\">Product Description</th>\n                <th style=\"width: 12%\" class=\"text-right\">Qty</th>\n                <th style=\"width: 8%\">UOM</th>\n                <th style=\"width: 15%\" class=\"text-right\">Unit Price</th>\n                <th style=\"width: 15%\" class=\"text-right\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td>{{ item.item_code }}</td>\n                <td>\n                    <div class=\"item-name\">{{ item.item_name }}</div>\n                    {% if item.description and item.description != item.item_name %}\n                    <small style=\"color: #666;\">{{ item.description[:150] }}</small>\n                    {% endif %}\n                </td>\n                <td style=\"text-align: right\">{{ item.qty }}</td>\n                <td>{{ item.uom }}</td>\n                <td style=\"text-align: right\">{{ item.rate }}</td>\n                <td style=\"text-align: right\">{{ item.amount }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- Totals -->\n    <div class=\"totals-section\">\n        <table class=\"totals-table\">\n            <tr>\n                <td>Subtotal:</td>\n                <td style=\"text-align: right\">{{ doc.currency }} {{ doc.total }}</td>\n            </tr>\n            {% if doc.discount_amount %}\n            <tr>\n                <td>Discount:</td>\n                <td style=\"text-align: right\">-{{ doc.currency }} {{ doc.discount_amount }}</td>\n            </tr>\n            {% endif %}\n            {% for tax in doc.taxes %}\n            <tr>\n                <td>{{ tax.description }}:</td>\n                <td style=\"text-align: right\">{{ doc.currency }} {{ tax.tax_amount }}</td>\n            </tr>\n            {% endfor %}\n            <tr class=\"total-row\">\n                <td>TOTAL:</td>\n                <td style=\"text-align: right\">{{ doc.currency }} {{ doc.grand_total }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Terms -->\n    {% if doc.terms %}\n    <div class=\"footer-section\">\n        <strong>Terms & Conditions:</strong><br>\n        {{ doc.terms }}\n    </div>\n    {% endif %}\n</div>",
